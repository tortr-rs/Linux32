CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=8192
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_PATA_AMD=y
CONFIG_PATA_OLDPIIX=y
CONFIG_NETDEVICES=y
CONFIG_8139TOO=y
CONFIG_E100=y
CONFIG_INPUT_EVDEV=m
CONFIG_SERIAL_8250=y
