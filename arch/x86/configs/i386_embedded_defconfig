# Target: 32-bit x86 embedded/industrial boards (Geode, Vortex86, etc.)
# Build:  make ARCH=i386 i386_embedded_defconfig && make ARCH=i386 -j$(nproc)

CONFIG_WERROR=y
CONFIG_LOCALVERSION="-embedded"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LINUX32_EMBEDDED=y
CONFIG_SYSVIPC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_LOG_BUF_SHIFT=14
CONFIG_BLK_DEV_INITRD=y
