# Linux32 embedded 32-bit tuning fragment
# Merge into any 32-bit .config:
#   ./scripts/kconfig/merge_config.sh -m .config kernel/configs/linux32-embedded.config
#
# copyright Koubba Mohamed Rayan — Chamesle-Certification-1.0

CONFIG_LINUX32_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_1000 is not set
CONFIG_LOG_BUF_SHIFT=14
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_SLUB=y
# CONFIG_SLAB is not set
# CONFIG_AUDIT is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_DEBUG_KERNEL is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_VFAT_FS=y
CONFIG_JFFS2_FS=y
CONFIG_UBIFS_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_GPIOLIB=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_REGULATOR=y
CONFIG_PWM=y
